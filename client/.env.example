#
# Example environment variables for the Vite frontend.
# Copy to `.env.local` for local development and building.
#

# Public HTTP endpoint for GraphQL (used by Apollo HttpLink)
# Example: http://localhost:4000/graphql or https://example.com/graphql
VITE_GRAPHQL_HTTP_URL=http://localhost:4000/graphql

# Public WebSocket endpoint for GraphQL subscriptions (used by GraphQLWsLink)
# Example: ws://localhost:4000/graphql or wss://example.com/graphql
VITE_GRAPHQL_WS_URL=ws://localhost:4000/graphql

